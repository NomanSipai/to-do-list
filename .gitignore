# Ignore node_modules in both frontend and backend
/frontend/node_modules/
/backend/node_modules/

# Build output directories
/frontend/dist/
/frontend/.vite/
/frontend/.next/
/frontend/public/

# Vite-specific
/.vite/
/vite.config.js

# Logs
*.log
logs/

# IDE/editor folders
/.vscode/
/.idea/

# Operating System files
.DS_Store
Thumbs.db

# Environment files
*.env
*.env.local
*.env.*.local

# Frontend-specific (Vite + React)
# Ignore the build folder for Vite
/frontend/dist/
/frontend/public/

# Ignore generated map files
/frontend/*.css.map
/frontend/*.scss.map

# Backend-specific (Node.js)
# Ignore backend-specific node_modules
/backend/node_modules/

# Ignore backend environment files
/backend/*.env
/backend/*.env.local
/backend/.env.*.local

# Ignore compiled files for backend
/backend/*.log
/backend/*.pid
/backend/*.tgz

# Coverage directories (for testing tools like Jest, Mocha, etc.)
/frontend/coverage/
/backend/coverage/

# Docker files (if using Docker in either folder)
/frontend/.dockerignore
/backend/.dockerignore
/frontend/Dockerfile
/backend/Dockerfile
/frontend/docker-compose.override.yml
/backend/docker-compose.override.yml

# Ignore temporary files like .vscode and editor backups
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Node.js specific
npm-debug.log
yarn-debug.log
yarn-error.log
